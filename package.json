{
  "name": "agent-code-sandbox",
  "version": "0.0.1",
  "description": "Run LLM-generated JavaScript/TypeScript safely from a Node.js AI agent, without OS isolation features.",
  "keywords": [
    "sandbox",
    "llm",
    "ai-agent",
    "code-interpreter",
    "deno",
    "agentcore"
  ],
  "license": "MIT",
  "author": "tmokmss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmokmss/agent-code-sandbox.git"
  },
  "homepage": "https://github.com/tmokmss/agent-code-sandbox#readme",
  "bugs": {
    "url": "https://github.com/tmokmss/agent-code-sandbox/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
